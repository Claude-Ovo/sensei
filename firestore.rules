rules_version = '2';

// Sensei — Firestore 安全规则
// - CLI 用 Admin SDK 写（绕过规则）。
// - 面板用 Web SDK 读：公开会话（public == true）谁都能看；非公开只有 ownerEmail 本人（Google 登录）能看。
// - 面板只能往 sessions/{sid}/inbound 追加（回答问题 / 反馈），其余一律只读。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function sessionDoc(sid) {
      return get(/databases/$(database)/documents/sessions/$(sid)).data;
    }

    function canSee(data) {
      return data.public == true || (signedIn() && data.ownerEmail == request.auth.token.email);
    }

    match /sessions/{sid} {
      allow read: if canSee(resource.data);
      allow create, update, delete: if false;

      match /inbound/{doc} {
        allow read: if canSee(sessionDoc(sid));
        // ask/note 会消耗 CLI 侧的 LLM 配额或写入笔记 → 必须 Google 登录并署名；
        // reply/feedback 保持免登录（评委一键可用），值域受白名单约束，CLI 侧另有限流。
        allow create: if canSee(sessionDoc(sid))
          && request.resource.data.keys().hasOnly(['kind', 'text', 'value', 'questionId', 'ts', 'by'])
          && request.resource.data.kind in ['reply', 'feedback', 'note', 'ask']
          && request.resource.data.ts == request.time
          && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 1000))
          && (!('value' in request.resource.data) || request.resource.data.value in ['helpful', 'too-basic', 'confusing', 'too-deep', 'just-tell-me', 'let-me-try', 'wrong'])
          && (!('questionId' in request.resource.data) || (request.resource.data.questionId is string && request.resource.data.questionId.size() <= 64))
          && (request.resource.data.kind != 'reply'
              || ('questionId' in request.resource.data
                  && request.resource.data.questionId is string
                  && request.resource.data.questionId.size() >= 1))
          && (
               (request.resource.data.kind in ['reply', 'feedback']
                 && (!('by' in request.resource.data) || request.resource.data.by == null
                     || (signedIn() && request.resource.data.by == request.auth.token.email)))
            || (request.resource.data.kind in ['ask', 'note']
                 && signedIn() && request.resource.data.by == request.auth.token.email)
             );
        allow update, delete: if false;
      }

      match /{sub}/{doc} {
        allow read: if sub != 'inbound' && canSee(sessionDoc(sid));
        allow write: if false;
      }
    }

    match /learners/{id} {
      allow read, write: if false;
    }

    match /_probe/{doc} {
      allow read, write: if false;
    }
  }
}
