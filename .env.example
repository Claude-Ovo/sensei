# Gemini API (AI Studio key) — used by ADK / @google/genai
GEMINI_API_KEY=
# Set to 1 to route through Vertex AI instead of the Gemini API
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Server
PORT=8080
SENSEI_MODEL=gemini-3.7-flash
SENSEI_CHEAP_MODEL=gemma-3-27b-it
FIRESTORE_DATABASE=(default)

# CLI
SENSEI_SERVER_URL=http://localhost:8080
SENSEI_TOKEN=
